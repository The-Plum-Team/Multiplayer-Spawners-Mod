{
    "schemaVersion": 1,
    "id": "${mod_id}",
    "version": "${version}",
    "name": "${mod_name}",
    "description": "${description}",
    "authors": [
        "${authors}"
    ],
    "contact": {
        "sources": "${sources}",
        "issues": "${issues}"
    },
    "license": "${license}",
    "environment": "*",
    "entrypoints": {
        "main": [
            "com.theplumteam.multiplayerspawners.MultiplayerSpawnersFabric"
        ],
        "client": [
            "com.theplumteam.multiplayerspawners.client.MultiplayerSpawnersFabricClient"
        ]
    },
    "mixins": [
        "multiplayerspawners.mixins.json",
        "multiplayerspawners.fabric.mixins.json"
    ],
    "depends": {
        "fabricloader": "${loader_requirement}",
        "fabric-api": "*",
        "minecraft": "${minecraft_requirement}",
        "java": "${java_requirement}"
    }
}
